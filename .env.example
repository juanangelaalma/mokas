# Database
DATABASE_URL="postgresql://mokas:mokas_secret@localhost:5432/mokas_db?schema=public"

# PostgreSQL (for Docker)
POSTGRES_USER=mokas
POSTGRES_PASSWORD=mokas_secret
POSTGRES_DB=mokas_db

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-in-production-min-32-chars

# App
NODE_ENV=development

# AI Configuration
# Provider options: gemini, openai, anthropic
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048

# API Keys (set the one matching your AI_PROVIDER)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
